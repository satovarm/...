│let scene, camera, renderer, penguin;

function init() {
    scene = new THREE.Scene();
    camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
    renderer = new THREE.WebGLRenderer();
    renderer.setSize(window.innerWidth, window.innerHeight);
    document.body.appendChild(renderer.domElement);
    
    let light = new THREE.AmbientLight(0xffffff, 1);
    scene.add(light);
    
    let groundGeometry = new THREE.PlaneGeometry(20, 20);
    let groundMaterial = new THREE.MeshLambertMaterial({ color: 0xffffff });
    let ground = new THREE.Mesh(groundGeometry, groundMaterial);
    ground.rotation.x = -Math.PI / 2;
    scene.add(ground);
    
    let loader = new THREE.TextureLoader();
    loader.load('https://i.imgur.com/Q9mbpUl.png', function(texture) {
        let penguinMaterial = new THREE.MeshBasicMaterial({ map: texture });
        let penguinGeometry = new THREE.BoxGeometry(1, 2, 1);
        penguin = new THREE.Mesh(penguinGeometry, penguinMaterial);
        penguin.position.set(0, 1, 0);
        scene.add(penguin);
    });
    
    let snowParticles = [];
    for (let i = 0; i < 100; i++) {
        let snowGeometry = new THREE.SphereGeometry(0.05, 8, 8);
        let snowMaterial = new THREE.MeshBasicMaterial({ color: 0xffffff });
        let snow = new THREE.Mesh(snowGeometry, snowMaterial);
        snow.position.set((Math.random() - 0.5) * 10, Math.random() * 5 + 2, (Math.random() - 0.5) * 10);
        scene.add(snow);
        snowParticles.push(snow);
    }
    
    camera.position.set(0, 3, 10);
    animate();
}

function animate() {
    requestAnimationFrame(animate);
    renderer.render(scene, camera);
}

function showMessage() {
    document.getElementById('message-box').style.display = 'block';
}

function showHappiness() {
    alert('¡El pingüino está feliz!');
}

window.onload = init;

